# Database Connection Settings (MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=portofolio_iqbal

# Admin Authentication (Kredensial Rahasia Anda Sendiri)
# Jangan pernah membagikan atau mengunggah nilai password ini ke publik!
ADMIN_USERNAME=admin_anda
ADMIN_PASSWORD=password_rahasia_anda_yang_kuat

# Kunci Enkripsi Sesi JWT (AES-256-GCM)
# Gunakan kombinasi acak minimal 32 karakter untuk enkripsi token
JWT_SECRET=kunci_rahasia_enkripsi_jwt_minimal_32_karakter_acak
